# Google Gemini API Key - Obrigatório para categorização com IA
# Obtenha em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel Blob Storage Token - Opcional para desenvolvimento local
# Se não configurado, o sistema usa armazenamento local (master.xlsx)
# Para produção, configure o token do Vercel Blob
BLOB_READ_WRITE_TOKEN=
